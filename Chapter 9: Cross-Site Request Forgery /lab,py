# ----------------------------------------------------------------- state ---
SESS = {}            # level -> {sid: {"user":..,"csrf":..}}
EMAILS = {}          # level -> {user: email}
POOL = {n: set() for n in LEVELS}     # L4 global token pool
KEYMAP = {n: {} for n in LEVELS}      # L5 csrfKey cookie -> token
for n in LEVELS:
