def flag(n):
    return "FLAG{csrf_l%d_%s}" % (n, hmac.new(SECRET.encode(), str(n).encode(), hashlib.sha256).hexdigest()[:12])

def solved(n):
    return EMAILS[n][VICTIM].lower().endswith("@evil-user.net")

